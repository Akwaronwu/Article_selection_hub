# Copy to `.env` and fill in values. NEVER commit a real `.env`.
# All backend settings use the SLR_ prefix (see backend/app/config.py).

SLR_ENVIRONMENT=development
SLR_DATABASE_URL=sqlite:///./data/slr.db
# Production example:
# SLR_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/slr

SLR_CORS_ORIGINS=["http://localhost:3000"]
SLR_DOCS_ENABLED=true
SLR_AUTO_CREATE_TABLES=true

# --- Sessions & registration ---
SLR_SESSION_COOKIE_NAME=slr_session
SLR_SESSION_TTL_HOURS=168
# Set to false after the first user exists to close open registration.
SLR_ALLOW_OPEN_REGISTRATION=true

# --- AI providers (Phase 7+; backend-only, never exposed to the browser) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# SLR_SCREENING_MODEL=
# SLR_EXTRACTION_MODEL=
# SLR_SYNTHESIS_MODEL=
